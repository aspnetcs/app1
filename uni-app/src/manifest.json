          "NSMicrophoneUsageDescription": "用于语音对话和录音功�?,
          "NSPhotoLibraryUsageDescription": "用于选择和保存图片附�?,
          "NSPhotoLibraryAddUsageDescription": "用于保存AI生成的图�?
        },
        "UIBackgroundModes": ["audio"],
        "urltypes": [
          {
            "urlschemes": ["webchat"]
          }
        ]
      }
    }
  },
  "mp-weixin": {
    "appid": "wx69a4a33ce06a2b37",
    "setting": {
